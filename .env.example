# Local development defaults to SQLite when DATABASE_URL is omitted.
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///calendar.db
AUTO_CREATE_DB=1
SEED_DEMO_DATA=1

# PythonAnywhere MySQL example:
# DATABASE_URL=mysql+pymysql://YOUR_USERNAME:YOUR_PASSWORD@YOUR_USERNAME.mysql.pythonanywhere-services.com/YOUR_DATABASE